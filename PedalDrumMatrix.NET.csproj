<Project Sdk="Microsoft.NET.Sdk">

  <!-- Buzz 1503 (32-bit) port. Buzz 1503 hosts managed machines on
       .NET Framework, so this targets net48 / x86 (1503 notes 1.1, 1.2).
       A .NET 10 assembly will not load in Buzz 1503. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Pedal Drum Matrix.NET</AssemblyName>
    <RootNamespace>PedalDrumMatrix</RootNamespace>
    <Version>1.3.6</Version>

    <!-- Mandatory deployment properties: Buzz only needs the .dll, so no
         .pdb or .deps.json is generated or deployed. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>MSB3277</NoWarn>

    <!-- Override on the command line if Buzz lives elsewhere:
         dotnet build -c Release -p:BuzzDir="D:\Buzz" -->
    <BuzzDir Condition="'$(BuzzDir)' == ''">C:\Program Files (x86)\Jeskola\Buzz</BuzzDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the SDK build net48 without the Developer Pack. Build-time only. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF framework assemblies (MessageBox for the About entry). -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />

    <!-- Buzz SDK assemblies: resolved from the Buzz install, never copied. -->
    <Reference Include="BuzzGUI.Interfaces">
      <HintPath>$(BuzzDir)\BuzzGUI.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- MenuItemVM / SimpleCommand for the right-click About entry. -->
    <Reference Include="BuzzGUI.Common">
      <HintPath>$(BuzzDir)\BuzzGUI.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy the DLL and its preset bundle to Gear\Effects. The bundle must
       share the DLL's base name (1503 notes 3.4). ContinueOnError keeps the
       build green if Buzz is running (DLL locked) or the prompt is not
       elevated; look for the Deploying line in the output. -->
  <Target Name="DeployToBuzz" AfterTargets="Build">
    <PropertyGroup>
      <PresetFile>$(MSBuildProjectDirectory)\$(AssemblyName).prs.xml</PresetFile>
    </PropertyGroup>
    <Message Text="Deploying $(TargetFileName) -> $(BuzzDir)\Gear\Effects\" Importance="high" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(BuzzDir)\Gear\Effects\"
          ContinueOnError="true" />
    <Copy Condition="Exists('$(PresetFile)')"
          SourceFiles="$(PresetFile)"
          DestinationFolder="$(BuzzDir)\Gear\Effects\"
          ContinueOnError="true" />
    <Warning Condition="!Exists('$(PresetFile)')" Text="Preset bundle not found: $(PresetFile)" />
  </Target>

</Project>
